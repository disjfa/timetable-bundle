{% extends "@DisjfaTimetable/base.html.twig" %}
{% trans_default_domain 'timetable' %}

{% block _disjfa_timetable_content %}

    {% include '@DisjfaTimetable/timetable/_style.html.twig' %}

    <div class="container py-4">
        {% include '@DisjfaTimetable/timetable/_menu.html.twig' %}

        <h3>{{ timetable.title }}</h3>
        <hr>

        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">{{ 'place.delete.title' | trans }}</h4>
            <p>{{ 'place.delete.confirm_message' | trans }}</p>
            <hr>
            <p class="mb-0">
                <strong>{{ 'place.delete.place_title' | trans }}</strong> {{ place.title }}
            </p>
        </div>

        <div class="d-flex align-items-center justify-content-between">
            {{ form_start(form) }}
            <button type="submit" class="btn btn-danger">{{ 'place.delete.button' | trans }}</button>
            {{ form_end(form) }}
            <a href="{{ path('disjfa_timetable_timetable_show', { timetable: timetable.id }) }}" class="btn btn-secondary">{{ 'place.delete.cancel' | trans }}</a>
        </div>
    </div>
{% endblock %}


